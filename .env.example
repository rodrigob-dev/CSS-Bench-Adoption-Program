# Supabase project → Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # server-only, never exposed to the browser
ADMIN_KEY=change-me   # shared key for /admin (park staff review queue)

# Transactional email (optional; skipped when unset). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=you@gmail.com, SMTP_PASS=<Google "app password">, MAIL_FROM="Riverbend Park <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ADMIN_EMAIL=        # staff inbox that gets a note on every new request
SITE_URL=https://your-deployment.vercel.app   # used in email links
